root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,jl}]
indent_size = 4

[*.R]
indent_size = 2

[*.{java,cpp,hpp,h}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{pdf,docx,pptx,xlsx,zip,png,jpg,wav,parquet}]
insert_final_newline = false
