   "source": "import matplotlib.pyplot as plt\n\nrate = 0.3\nimax = 50\nharvested = 290  # Number of fish removed each year\nfish = [0]*imax\n\nfish[0] = 1000\nfor i in range(imax-1):\n    fish[i+1] = (1+rate)*fish[i] - harvested   # Difference equation model with harvesting\n\nplt.plot(fish)\nfish[imax-1]"
  }
